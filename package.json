{
  "name": "apollo-graphql-server",
  "version": "1.0.0",
  "description": "Apollo GraphQL Server (test project)",
  "homepage": "https://github.com/stas-hanchev/apollo-graphql-server#readme",
  "bugs": {
    "url": "https://github.com/stas-hanchev/apollo-graphql-server/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stas-hanchev/apollo-graphql-server.git"
  },
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "build": "prisma generate",
    "start": "node src/index.js",
    "start:prod": "prisma migrate deploy && cross-env NODE_ENV=production node src/index.js",
    "studio": "prisma studio --url file://./dev.db",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@graphql-tools/schema": "^10.1.3",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "express": "^5.2.1",
    "graphql": "^16.14.2",
    "graphql-subscriptions": "^3.0.0",
    "graphql-ws": "^6.3.0",
    "jsonwebtoken": "^9.0.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "dotenv": "^18.0.5",
    "prisma": "^7.10.0"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "@prisma/client@7.10.0": true,
    "@apollo/protobufjs@1.2.8": true,
    "better-sqlite3@12.11.1": true
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.5"
  }
}
